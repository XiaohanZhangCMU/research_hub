---
import { getCollection } from 'astro:content';
import '../styles/global.css';

const recentPosts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Technical essays, research notes, and half-formed ideas at the intersection of LLM training, numerical methods, and scientific computing." />
    <title>Xiaohan Zhang (张小寒)</title>
  </head>
  <body class="bg-white text-gray-900 font-sans antialiased">
    <main class="max-w-3xl mx-auto px-6 py-20">
      <div class="mb-16">
        <h1 class="text-3xl font-bold tracking-tight mb-6">Xiaohan Zhang (张小寒)</h1>
        <div class="space-y-4 text-gray-600 leading-relaxed">
          <p>
            This site is a place for technical essays, research notes, derivations, implementation details, and 
            half-formed ideas at the intersection of LLM training/post-training, numerical methods for 
            stochastic processes, and scientific computing in general.
          </p>
          <p>
            About me: I grew up in Hohhot, Inner Mongolia, a small city in north China. 
            I began my career as a computational mechanics researcher at Carnegie Mellon and then
            Stanford, working on hyperbolic PDE simulations, molecular dynamics, and numerical
            methods for physical systems. At some point, I wanted to understand the universe! Then
            realized that might be too ambitious. So I switched to machine learning in 2018, hoping
            that perhaps I could build models that understand it instead.
          </p>
          <p>
            Since 2018, I've worked across applied ML and AI systems: first at Salesforce on
            time-series clustering and forecasting, then at Databricks/MosaicML as a research
            engineer working on LLM training infrastructure, and now at Baseten, where I work on
            post-training research.
          </p>
        </div>
        <div class="flex gap-4 mt-6 text-sm text-gray-400">
          <a href="/writing" class="hover:text-gray-700 transition-colors">Writing</a>
          <span>·</span>
          <a href="https://github.com/XiaohanZhangCMU" class="hover:text-gray-700 transition-colors">GitHub</a>
        </div>
      </div>

      {recentPosts.length > 0 && (
        <section>
          <h2 class="text-xs font-semibold uppercase tracking-widest text-gray-400 mb-6">Recent</h2>
          <div class="space-y-6">
            {recentPosts.map(post => (
              <a href={`/writing/${post.slug}`} class="group block">
                <h3 class="font-medium group-hover:text-blue-600 transition-colors">
                  {post.data.title}
                </h3>
                <p class="text-sm text-gray-500 mt-0.5 leading-relaxed">
                  {post.data.description}
                </p>
              </a>
            ))}
          </div>
          <div class="mt-8">
            <a href="/writing" class="text-sm text-gray-400 hover:text-gray-700 transition-colors">
              All posts →
            </a>
          </div>
        </section>
      )}
    </main>
  </body>
</html>
